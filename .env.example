# Naija Wave — environment configuration (copy to .env)
PORT=3000

# REQUIRED for founder setup: a long random secret only you know.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_KEY=change-me-to-a-long-random-secret

# REQUIRED in production: long random secret for login tokens
JWT_SECRET=change-me-to-another-long-random-secret

# OTP delivery: 'dev' shows codes in server logs/API (for building & testing).
# 'live' expects an SMS/email provider (see docs/DEPLOYMENT.md) — no codes are exposed.
OTP_MODE=dev

# Paths
DB_PATH=./data/naijawave.db
UPLOAD_DIR=./uploads

# WebRTC (optional in production): free Google STUN is the default.
# For strict networks add a TURN server (see docs/DEPLOYMENT.md).
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-host:3478
# TURN_USER=
# TURN_PASS=
